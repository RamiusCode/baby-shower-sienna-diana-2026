---
// src/components/CodigoVestimenta.astro
// Despedida — último componente de la invitación.
// Texto "¡Te esperamos!" arriba, los tres animalitos en fila y, abajo,
// floresarriba.png volteada verticalmente haciendo de borde de hojas.
---

<section id="vestimenta-section">
  <div id="cv-lienzo">
    <!-- ═══════ TEXTO ═══════ -->
    <h3 id="cv-titulo" class="font-great-vibes">¡Te esperamos!</h3>

    <!-- ═══════ FOTO ═══════ -->
    <div id="cv-foto">
      <img src="/imagenes/esperamos.png" alt="Te esperamos" />
    </div>

    <!-- ═══════ ANIMALES ═══════ -->
    <img id="cv-jirafa" src="/imagenes/jirafa.png" alt="" />
    <img id="cv-leon" src="/imagenes/leon.png" alt="" />
    <img id="cv-elefante" src="/imagenes/elefante.png" alt="" />

    <!-- ═══════ HOJAS ABAJO (floresarriba volteada) ═══════ -->
    <img id="cv-flores" src="/imagenes/floresarriba.png" alt="" />
  </div>
</section>

<style>
  #vestimenta-section {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
    overflow-x: hidden;
    background: transparent;
    padding: 0.5rem 0 0;
  }

  /* ═══════ LIENZO ═══════ */
  #cv-lienzo {
    position: relative;
    width: min(100vw, 480px);
    aspect-ratio: 480 / 780;
    container-type: inline-size;
  }

  #cv-lienzo img {
    display: block;
    user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  /* ── Texto ── */
  #cv-titulo {
    position: absolute;
    top: 4%;
    left: 5cqw;
    width: 90cqw;
    margin: 0;
    z-index: 4;
    text-align: center;
    font-size: 17cqw;
    line-height: 1.1;
    font-weight: 400;
    color: #c49a63;
    text-shadow:
      0 1px 0 rgba(255, 255, 255, 0.85),
      0 3px 12px rgba(255, 255, 255, 0.7);
  }

  /* ── Foto ── */
  #cv-foto {
    position: absolute;
    top: 17%;
    left: 24cqw;
    width: 52cqw;
    z-index: 3;
    padding: 2.6cqw;
    border-radius: 3.5cqw;
    background: #fdfcf5;
    border: 1px solid rgba(142, 156, 107, 0.5);
    box-shadow:
      0 2px 6px rgba(90, 105, 70, 0.12),
      0 14px 28px rgba(90, 105, 70, 0.2);
    transform: rotate(-2.2deg);
  }

  #cv-foto img {
    width: 100%;
    height: auto;
    /* proporción original de esperamos.png */
    aspect-ratio: 843 / 1264;
    object-fit: cover;
    border-radius: 2cqw;
  }

  /* ── Hojas de abajo (volteadas verticalmente, proporción original) ── */
  #cv-flores {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: auto;
    /* mantiene el tamaño original de la imagen */
    aspect-ratio: 1080 / 549;
    z-index: 2;
    transform: scaleY(-1);
  }

  /* ── Animales, apoyados al tope de abajo ── */
  #cv-jirafa,
  #cv-leon,
  #cv-elefante {
    position: absolute;
    bottom: 0;
    height: auto;
    z-index: 3;
    filter: drop-shadow(0 5px 10px rgba(90, 110, 60, 0.18));
  }

  #cv-jirafa {
    left: 2cqw;
    width: 28cqw;
  }

  #cv-leon {
    left: 33cqw;
    width: 34cqw;
  }

  #cv-elefante {
    left: 69cqw;
    width: 30cqw;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const inicial = () => {
      gsap.set("#cv-titulo", { opacity: 0, y: 20 });
      // el scaleY: -1 mantiene las hojas volteadas mientras se animan
      gsap.set("#cv-flores", { opacity: 0, y: "35%", scaleY: -1 });
      gsap.set("#cv-foto", { opacity: 0, y: 34, scale: 0.94, rotate: -7 });
      gsap.set("#cv-jirafa", { opacity: 0, x: "-60%" });
      gsap.set("#cv-leon", { opacity: 0, y: "40%" });
      gsap.set("#cv-elefante", { opacity: 0, x: "60%" });
    };

    inicial();

    ScrollTrigger.create({
      trigger: "#vestimenta-section",
      start: "top 82%",
      onEnter: () => {
        const tl = gsap.timeline();
        tl.to(
          "#cv-titulo",
          { opacity: 1, y: 0, duration: 1.2, ease: "power2.out" },
          0,
        )
          .to(
            "#cv-foto",
            {
              opacity: 1,
              y: 0,
              scale: 1,
              rotate: -2.2,
              duration: 1.4,
              ease: "back.out(1.3)",
            },
            0.35,
          )
          .to(
            "#cv-flores",
            { opacity: 1, y: "0%", scaleY: -1, duration: 1.6, ease: "power2.out" },
            0.3,
          )
          .to(
            ["#cv-jirafa", "#cv-leon", "#cv-elefante"],
            {
              opacity: 1,
              x: 0,
              y: 0,
              duration: 1.4,
              stagger: 0.14,
              ease: "power2.out",
            },
            0.5,
          );
      },
      onLeaveBack: inicial,
    });
  });
</script>
