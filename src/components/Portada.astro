---
// src/components/Portada.astro
// Portada Baby Shower — temática Safari
// El diseño vive dentro de #marco, un lienzo de proporción fija (480 x 880).
// Todo se mide en cqw (1cqw = 1% del ancho del marco), así se ve EXACTAMENTE
// igual en celular, laptop y PC: solo cambia la escala, nunca la composición.
---

<section id="portada-section">
    <!-- Fondo difuminado que rellena la pantalla en cualquier proporción -->
    <div id="backdrop"></div>

    <!-- ═══════════ LIENZO DE PROPORCIÓN FIJA ═══════════ -->
    <div id="marco">
        <!-- ── Título (logo) ── -->
        <div id="titulo-wrap">
            <img id="logo" src="/imagenes/logo.png" alt="Baby Shower" />
        </div>

        <!-- ── Sobre + instrucción (clic para abrir) ── -->
        <div id="sobre-bloque">
            <div id="sobre-container" role="button" tabindex="0" aria-label="Abrir invitación">
                <img src="/imagenes/sobre.png" alt="Sobre de invitación" />
            </div>

            <p id="instruccion" class="font-crimson">
                Haz clic en el sobre <br />para ver la invitación
            </p>

            <!-- ── Elefante, debajo de la instrucción ── -->
            <img id="elefante3" src="/imagenes/elefante3.png" alt="" />
        </div>
    </div>
</section>

<style is:global>
    /* Bloquea el scroll mientras la portada está visible */
    body.portada-activa {
        overflow: hidden !important;
        height: 100vh;
    }
</style>

<style>
    #portada-section {
        position: fixed;
        inset: 0;
        z-index: 10000;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background-color: #e6f0d8;
    }

    /* Relleno para pantallas más altas/anchas que el lienzo */
    #backdrop {
        position: absolute;
        inset: -8%;
        background: url("/imagenes/fondosafari.webp") center / cover no-repeat;
        filter: blur(22px) saturate(1.05);
        transform: scale(1.1);
        pointer-events: none;
    }

    /* ═══════════ LIENZO (ancho fijo tipo celular, alto completo) ═══════════ */
    #marco {
        position: relative;
        /* fallback para navegadores sin svh */
        width: min(100vw, 480px, calc(100vh * 480 / 880));
        width: min(100vw, 480px, calc(100svh * 480 / 880));
        height: 100vh;
        height: 100svh;
        container-type: size;
        /* ancho original de la imagen, estirada a lo alto para ocupar todo */
        background: url("/imagenes/fondosafari.png") top center / 100% 100%
            no-repeat;
        overflow: hidden;
        box-shadow: 0 0 60px rgba(60, 90, 40, 0.28);
    }

    #marco img {
        display: block;
        user-select: none;
        -webkit-user-drag: none;
    }

    /* ── Título (logo) ── */
    #titulo-wrap {
        position: absolute;
        top: 27%;
        left: 50%;
        transform: translateX(-50%);
        width: 86cqw;
        display: flex;
        flex-direction: column;
        align-items: center;
        z-index: 4;
        pointer-events: none;
    }

    #logo {
        width: 58cqw;
        height: auto;
        /* halo rosado suave para despegarlo del fondo */
        filter: drop-shadow(0 2px 6px rgba(255, 255, 255, 0.85))
            drop-shadow(0 6px 18px rgba(228, 140, 162, 0.45));
    }

    /* ── Sobre + instrucción ── */
    #sobre-bloque {
        position: absolute;
        top: 46%;
        left: 50%;
        transform: translateX(-50%);
        width: 76cqw;
        z-index: 5;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    #sobre-container {
        width: 100%;
        cursor: pointer;
        outline: none;
    }

    #sobre-container img {
        width: 100%;
        height: auto;
        /* sin luminancia: el sobre va limpio, sin halo ni sombra */
        filter: none;
    }

    #instruccion {
        /* Mismo aire que hay entre el logo y el sobre:
           alto del marco = 183.33cqw · logo baja a 27% (49.5cqw) y mide
           58/2 = 29cqw de alto → termina en 78.5cqw · el sobre arranca en
           46% (84.3cqw). Separación = 5.8cqw, más un pelín de aire. */
        margin: 8cqw 0 0;
        max-width: 60cqw;
        font-size: 4.4cqw;
        font-weight: 700;
        line-height: 1.35;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        text-align: center;
        color: #d47a95;
        cursor: pointer;
        text-shadow:
            0 1px 0 rgba(255, 255, 255, 0.9),
            0 0 10px rgba(255, 255, 255, 0.95),
            0 0 18px rgba(255, 255, 255, 0.85),
            0 0 26px rgba(244, 168, 188, 0.75);
    }

    /* ── Elefante, debajo de la instrucción ── */
    #elefante3 {
        width: 34cqw;
        height: auto;
        margin-top: 6cqw;
        pointer-events: none;
        filter: drop-shadow(0 6px 14px rgba(190, 130, 155, 0.22));
    }
</style>

<script>
    import { gsap } from "gsap";

    if (typeof window !== "undefined") {
        document.addEventListener("DOMContentLoaded", () => {
            document.body.classList.add("portada-activa");

            // ── Estado inicial ──────────────────────────────────────
            gsap.set("#logo", { opacity: 0, y: -14, scale: 0.94 });
            gsap.set("#sobre-container", { opacity: 0, y: 26, scale: 0.9 });
            gsap.set("#instruccion", { opacity: 0, y: 10 });
            gsap.set("#elefante3", { opacity: 0, y: 24, scale: 0.9 });

            // ── Entrada ─────────────────────────────────────────────
            const tl = gsap.timeline({ delay: 0.25 });

            // Todo entra a la vez
            tl.to(
                "#logo",
                {
                    opacity: 1,
                    y: 0,
                    scale: 1,
                    duration: 1.2,
                    ease: "back.out(1.4)",
                },
                0,
            )
                .to(
                    "#sobre-container",
                    {
                        opacity: 1,
                        y: 0,
                        scale: 1,
                        duration: 1.2,
                        ease: "back.out(1.4)",
                    },
                    0,
                )
                .to(
                    "#instruccion",
                    { opacity: 1, y: 0, duration: 1.2, ease: "power2.out" },
                    0,
                )
                .to(
                    "#elefante3",
                    {
                        opacity: 1,
                        y: 0,
                        scale: 1,
                        duration: 1.3,
                        ease: "back.out(1.3)",
                    },
                    0.2,
                );

            // ── Reposo ──────────────────────────────────────────────
            tl.add(() => {
                // El sobre late para invitar al toque
                gsap.to("#sobre-container", {
                    scale: 1.035,
                    duration: 1.9,
                    repeat: -1,
                    yoyo: true,
                    ease: "sine.inOut",
                });
                gsap.to("#instruccion", {
                    opacity: 0.62,
                    duration: 1.4,
                    repeat: -1,
                    yoyo: true,
                    ease: "sine.inOut",
                });
            }, 1.4);

            // ── Hover sobre ─────────────────────────────────────────
            const sobreContainer = document.getElementById("sobre-container");

            sobreContainer?.addEventListener("mouseenter", () => {
                gsap.to("#sobre-container", {
                    y: -8,
                    scale: 1.06,
                    duration: 0.3,
                    ease: "power2.out",
                });
            });
            sobreContainer?.addEventListener("mouseleave", () => {
                gsap.to("#sobre-container", {
                    y: 0,
                    scale: 1,
                    duration: 0.3,
                    ease: "power2.out",
                });
            });

            // ── Click ───────────────────────────────────────────────
            const portadaSection = document.getElementById("portada-section");

            const abrirInvitacion = () => {
                gsap.killTweensOf([
                    "#logo",
                    "#sobre-container",
                    "#instruccion",
                    "#elefante3",
                ]);

                const audio = new Audio("/musica/melo.mp3");
                audio.loop = true;
                audio.volume = 0.5;
                audio.play().catch(() => {});

                (window as any).audioGlobal = audio;
                (window as any).estaReproduciendoGlobal = true;
                window.dispatchEvent(new CustomEvent("musica-iniciada"));

                const tlSalida = gsap.timeline();

                tlSalida
                    .to("#sobre-container", {
                        scale: 1.1,
                        duration: 0.2,
                        ease: "power2.in",
                    })
                    .to(
                        ["#instruccion", "#logo", "#elefante3"],
                        {
                            opacity: 0,
                            y: -16,
                            duration: 0.4,
                            stagger: 0.06,
                            ease: "power2.in",
                        },
                        0.1,
                    )
                    .to(
                        "#sobre-container",
                        {
                            opacity: 0,
                            scale: 1.35,
                            duration: 0.4,
                            ease: "power2.in",
                        },
                        0.3,
                    )
                    .to(
                        portadaSection,
                        {
                            opacity: 0,
                            duration: 0.5,
                            ease: "power2.in",
                            onStart: () => {
                                document.body.classList.remove("portada-activa");
                            },
                            onComplete: () => {
                                portadaSection?.remove();
                                window.scrollTo({ top: 0, behavior: "smooth" });

                                // Avisa al resto de secciones: recién ahora
                                // se ven, así que recién ahora deben animar.
                                (window as any).invitacionAbierta = true;
                                window.dispatchEvent(
                                    new CustomEvent("invitacion-abierta"),
                                );
                            },
                        },
                        0.5,
                    );
            };

            sobreContainer?.addEventListener("click", abrirInvitacion);
            document
                .getElementById("instruccion")
                ?.addEventListener("click", abrirInvitacion);
            sobreContainer?.addEventListener("keydown", (e) => {
                if (e.key === "Enter" || e.key === " ") {
                    e.preventDefault();
                    abrirInvitacion();
                }
            });
        });
    }
</script>
