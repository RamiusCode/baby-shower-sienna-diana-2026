---
// src/components/Contenido.astro
// "¡Es un niño!" — anuncio del baby shower: los papis están esperando un niño.
// Foto con marco tipo fotografía antigua (polaroid) inclinada y hojas al costado.
---

<section id="contenido-section">
  <div id="ct-col">
    <!-- ═══════ ANUNCIO ═══════ -->
    <p id="ct-kicker" class="font-cormorant">
      Con mucha alegría les contamos que...
    </p>

    <h2 id="ct-titulo" class="font-great-vibes">¡Es un niño!</h2>

    <div id="ct-divisor">
      <span class="ct-div-linea"></span>
      <span class="ct-div-punto"></span>
      <span class="ct-div-linea"></span>
    </div>

    <!-- ═══════ FOTO CON MARCO ═══════ -->
    <div id="ct-foto">
      <!-- hojas detrás de la foto -->
      <div class="ct-hoja ct-hoja-izq">
        <img src="/imagenes/costado.png" alt="" />
      </div>
      <div class="ct-hoja ct-hoja-der">
        <img src="/imagenes/costado.png" alt="" />
      </div>

      <div class="ct-marco">
        <div class="ct-inner">
          <img src="/imagenes/foto1.png" alt="Foto" />
        </div>
      </div>
    </div>

    <!-- ═══════ FRASE FINAL ═══════ -->
    <p id="ct-frase" class="font-cormorant">
      Y muy pronto lo tendremos en nuestros brazos
    </p>
  </div>
</section>

<style>
  #contenido-section {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
    overflow-x: hidden;
    padding: 2.5rem 0 0;
  }

  #ct-col {
    position: relative;
    width: min(100vw, 480px);
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* ── Anuncio ── */
  #ct-kicker {
    margin: 0;
    max-width: 78cqw;
    text-align: center;
    /* text-xl */
    font-size: 1.25rem;
    line-height: 1.4;
    font-style: italic;
    color: #8e9c6b;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.75);
  }

  #ct-titulo {
    margin: 1.5cqw 0 0;
    font-size: 17cqw;
    line-height: 1.1;
    font-weight: 400;
    text-align: center;
    color: #6f8442;
    text-shadow:
      0 1px 0 rgba(255, 255, 255, 0.85),
      0 3px 12px rgba(255, 255, 255, 0.7);
  }

  /* ── Divisor ── */
  #ct-divisor {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.2cqw;
    margin-top: 2.5cqw;
  }

  .ct-div-linea {
    display: block;
    width: 14cqw;
    height: 1px;
    background: rgba(142, 156, 107, 0.6);
  }

  .ct-div-punto {
    display: block;
    width: 1.5cqw;
    height: 1.5cqw;
    border-radius: 50%;
    background: #c49a63;
  }

  /* ── Foto ── */
  #ct-foto {
    position: relative;
    width: 74cqw;
    margin-top: 7cqw;
  }

  /* Hojas que asoman por detrás de la foto */
  .ct-hoja {
    position: absolute;
    top: 50%;
    /* mismo tamaño que las hojas de NombresFlores */
    width: 15.4cqw;
    z-index: 0;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .ct-hoja img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* -13cqw = borde de la columna (la foto mide 74cqw y está centrada),
     así quedan chocando al borde igual que en NombresFlores */
  .ct-hoja-izq {
    left: -13cqw;
  }

  .ct-hoja-der {
    right: -13cqw;
  }

  .ct-hoja-der img {
    transform: scaleX(-1);
  }

  /* Marco blanco tipo fotografía antigua, con la inclinación */
  .ct-marco {
    position: relative;
    z-index: 1;
    background: linear-gradient(160deg, #ffffff 0%, #fdfcf6 60%, #f7f5ea 100%);
    padding: 4cqw 4cqw 12cqw;
    border-radius: 2px;
    transform: rotate(-3.5deg);
    box-shadow:
      0 2px 4px rgba(90, 105, 70, 0.14),
      0 16px 34px rgba(90, 105, 70, 0.22);
  }

  .ct-inner {
    position: relative;
    width: 100%;
    aspect-ratio: 896 / 1195;
    overflow: hidden;
    background: #eef1e6;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.07);
  }

  .ct-inner img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* ── Frase final ── */
  #ct-frase {
    margin: 7cqw 0 0;
    max-width: 76cqw;
    text-align: center;
    /* text-xl */
    font-size: 1.25rem;
    line-height: 1.45;
    font-style: italic;
    color: #8e9c6b;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.75);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const textos = ["#ct-kicker", "#ct-titulo", "#ct-divisor"];

    const inicial = () => {
      gsap.set(textos, { opacity: 0, y: 20 });
      gsap.set("#ct-foto", { opacity: 0, y: 40, scale: 0.94 });
      gsap.set(".ct-marco", { rotate: -9 });
      gsap.set("#ct-frase", { opacity: 0, y: 16 });
    };

    inicial();

    ScrollTrigger.create({
      trigger: "#contenido-section",
      start: "top 80%",
      onEnter: () => {
        const tl = gsap.timeline();
        tl.to(
          textos,
          { opacity: 1, y: 0, duration: 1.1, stagger: 0.16, ease: "power2.out" },
          0,
        )
          .to(
            "#ct-foto",
            { opacity: 1, y: 0, scale: 1, duration: 1.4, ease: "power2.out" },
            0.5,
          )
          // la foto se acomoda girando suavemente hasta su inclinación final
          .to(
            ".ct-marco",
            { rotate: -3.5, duration: 1.6, ease: "back.out(1.5)" },
            0.5,
          )
          .to(
            "#ct-frase",
            { opacity: 1, y: 0, duration: 1.1, ease: "power2.out" },
            1.1,
          );
      },
      onLeaveBack: inicial,
    });
  });
</script>
