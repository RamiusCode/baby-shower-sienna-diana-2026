---
// DespedidaDedicatoria.astro
---

<section
  id="despedida-section"
  class="relative w-full overflow-hidden py-16 px-6"
  style="background-color: #fe9cb4;"
>
  <!-- Flores esquinas -->
  <img
    id="dd-flor-tl"
    src="/imagenes/flor4.png"
    alt=""
    class="absolute pointer-events-none select-none"
    style="top: -3%; left: -4%; width: 26%; z-index: 5;"
  />
  <img
    id="dd-flor-br"
    src="/imagenes/flor4.png"
    alt=""
    class="absolute pointer-events-none select-none"
    style="bottom: -3%; right: -4%; width: 25%; transform: scale(-1, -1); z-index: 5;"
  />

  <!-- Contenido -->
  <div class="relative z-10 max-w-md mx-auto flex flex-col items-center text-center">
    <!-- Corona -->
    <img
      id="dd-corona"
      src="/imagenes/corona.png"
      alt="corona"
      class="block select-none"
      style="width: 150px; filter: drop-shadow(0 2px 5px rgba(180,140,80,0.3));"
    />

    <!-- Moño -->
    <img
      id="dd-mono"
      src="/imagenes/mono4.png"
      alt=""
      class="block select-none"
      style="width: 300px; max-width: 88%; margin-top: 14px;"
    />

    <!-- Texto -->
    <p
      id="dd-texto"
      class="font-great-vibes"
      style="color: #ffffff; line-height: 1.1; margin-top: 26px; font-size: clamp(2.6rem, 12vw, 3.6rem); text-shadow: 0 2px 6px rgba(160,60,90,0.25);"
    >
      ¡No te lo pierdas!
    </p>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    gsap.set("#dd-flor-tl", { opacity: 0, x: -30, y: -30 });
    gsap.set("#dd-flor-br", { opacity: 0, x: 30, y: 30 });
    gsap.set("#dd-corona", { opacity: 0, y: -18, scale: 0.85 });
    gsap.set("#dd-mono", { opacity: 0, y: 20, scale: 0.9 });
    gsap.set("#dd-texto", { opacity: 0, y: 16 });

    ScrollTrigger.create({
      trigger: "#despedida-section",
      start: "top 80%",
      onEnter: () => {
        const tl = gsap.timeline();
        tl.to(["#dd-flor-tl", "#dd-flor-br"], {
          opacity: 1, x: 0, y: 0, duration: 1.1, stagger: 0.12, ease: "power2.out",
        }, 0)
          .to("#dd-corona", { opacity: 1, y: 0, scale: 1, duration: 1.0, ease: "back.out(1.4)" }, 0.3)
          .to("#dd-mono", { opacity: 1, y: 0, scale: 1, duration: 1.0, ease: "back.out(1.3)" }, 0.5)
          .to("#dd-texto", { opacity: 1, y: 0, duration: 1.0, ease: "power2.out" }, 0.75);

        // Flotación suave de la corona
        gsap.to("#dd-corona", {
          y: -5, rotation: -2, duration: 3.5, repeat: -1, yoyo: true, ease: "sine.inOut", delay: 1.4,
        });
      },
      onLeaveBack: () => {
        gsap.killTweensOf("#dd-corona");
        gsap.set("#dd-flor-tl", { opacity: 0, x: -30, y: -30 });
        gsap.set("#dd-flor-br", { opacity: 0, x: 30, y: 30 });
        gsap.set("#dd-corona", { opacity: 0, y: -18, scale: 0.85 });
        gsap.set("#dd-mono", { opacity: 0, y: 20, scale: 0.9 });
        gsap.set("#dd-texto", { opacity: 0, y: 16 });
      },
    });
  });
</script>
