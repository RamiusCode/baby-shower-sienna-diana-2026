---
// Dedicatoria.astro
---

<section
  id="dedicatoria-section"
  class="relative w-full overflow-hidden py-14 px-6"
  style="background-color: #fe9cb4;"
>
  <div class="max-w-md mx-auto text-center flex flex-col items-center">
    <!-- Separador superior (corazón) -->
    <img
      id="d-sep1"
      src="/imagenes/separador.png"
      alt=""
      class="block w-full select-none"
      style="max-width: 330px;"
    />

    <!-- Texto -->
    <p
      id="d-texto"
      class="font-charm"
      style="color: #ffffff; line-height: 1.6; margin: 26px 0; font-size: clamp(1.2rem, 5.2vw, 1.55rem); max-width: 340px;"
    >
      Con la bendición de Dios y el amor que mis padres me han dado,
      me siento feliz de llegar a este momento de mi vida, el día que
      dejaré atrás mi infancia y comenzaré un nuevo viaje.
    </p>

    <!-- Separador inferior (moño) -->
    <img
      id="d-sep2"
      src="/imagenes/separador2.png"
      alt=""
      class="block w-full select-none"
      style="max-width: 330px;"
    />
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    gsap.set("#d-sep1", { opacity: 0, y: -18, scaleX: 0.8 });
    gsap.set("#d-texto", { opacity: 0, y: 14 });
    gsap.set("#d-sep2", { opacity: 0, y: 18, scaleX: 0.8 });

    ScrollTrigger.create({
      trigger: "#dedicatoria-section",
      start: "top 80%",
      onEnter: () => {
        const tl = gsap.timeline();
        tl.to("#d-sep1", { opacity: 1, y: 0, scaleX: 1, duration: 1.0, ease: "power2.out" }, 0)
          .to("#d-texto", { opacity: 1, y: 0, duration: 1.2, ease: "power2.out" }, 0.3)
          .to("#d-sep2", { opacity: 1, y: 0, scaleX: 1, duration: 1.0, ease: "power2.out" }, 0.6);
      },
      onLeaveBack: () => {
        gsap.set("#d-sep1", { opacity: 0, y: -18, scaleX: 0.8 });
        gsap.set("#d-texto", { opacity: 0, y: 14 });
        gsap.set("#d-sep2", { opacity: 0, y: 18, scaleX: 0.8 });
      },
    });
  });
</script>
